[{"/home/evanyang/Desktop/researchcollabs/client/src/index.js":"1","/home/evanyang/Desktop/researchcollabs/client/src/App.js":"2","/home/evanyang/Desktop/researchcollabs/client/src/reportWebVitals.js":"3","/home/evanyang/Desktop/researchcollabs/client/src/pages/Landing/Landing.js":"4","/home/evanyang/Desktop/researchcollabs/client/src/pages/Register/Register.js":"5","/home/evanyang/Desktop/researchcollabs/client/src/contexts/userContext.js":"6","/home/evanyang/Desktop/researchcollabs/client/src/reducers/userReducer.js":"7","/home/evanyang/Desktop/researchcollabs/client/src/pages/Home/Home.js":"8"},{"size":535,"mtime":1723840837907,"results":"9","hashOfConfig":"10"},{"size":608,"mtime":1713473166589,"results":"11","hashOfConfig":"10"},{"size":362,"mtime":1713473166593,"results":"12","hashOfConfig":"10"},{"size":1470,"mtime":1723840872095,"results":"13","hashOfConfig":"10"},{"size":2605,"mtime":1723840889460,"results":"14","hashOfConfig":"10"},{"size":3270,"mtime":1713473166589,"results":"15","hashOfConfig":"10"},{"size":478,"mtime":1713473166593,"results":"16","hashOfConfig":"10"},{"size":389,"mtime":1723840904876,"results":"17","hashOfConfig":"10"},{"filePath":"18","messages":"19","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"1sfb30z",{"filePath":"20","messages":"21","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"22"},{"filePath":"23","messages":"24","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"22"},{"filePath":"25","messages":"26","errorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"27","messages":"28","errorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"29","messages":"30","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"31","usedDeprecatedRules":"22"},{"filePath":"32","messages":"33","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"22"},{"filePath":"34","messages":"35","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},"/home/evanyang/Desktop/researchcollabs/client/src/index.js",[],"/home/evanyang/Desktop/researchcollabs/client/src/App.js",[],["36","37"],"/home/evanyang/Desktop/researchcollabs/client/src/reportWebVitals.js",[],"/home/evanyang/Desktop/researchcollabs/client/src/pages/Landing/Landing.js",["38","39","40","41"],"/home/evanyang/Desktop/researchcollabs/client/src/pages/Register/Register.js",["42","43","44","45"],"/home/evanyang/Desktop/researchcollabs/client/src/contexts/userContext.js",["46"],"import React, { createContext, useReducer, useEffect } from \"react\";\nimport { userReducer } from \"../reducers/userReducer\";\nimport { useHistory } from \"react-router-dom\";\nimport axios from \"axios\";\nimport { UPDATE_USER, USER_LOGOUT, USER_ERROR } from \"../reducers/userReducer\";\n\nconst UserContext = createContext();\n\nconst initialState = {\n  user: { name: \"\" },\n};\n\nconst UserProvider = (props) => {\n  const history = useHistory();\n  const [userState, dispatch] = useReducer(userReducer, initialState);\n\n  const serverURL =\n    process.env.NODE_ENV === \"development\"\n      ? \"http://localhost:4000\"\n      : process.env.serverURL;\n\n  const actions = {\n    signup: async (email, password) => {\n      try {\n        const res = await axios.post(`${serverURL}/user/signup`, {\n          email,\n          password,\n        });\n        dispatch({ type: UPDATE_USER, payload: res.data });\n        history.push(\"/home\");\n      } catch (err) {\n        console.error(err);\n        if (err.message.includes(\"400\")) {\n          dispatch({\n            type: USER_ERROR,\n            payload: \"User already exists.\",\n          });\n        }\n        if (err.message.includes(\"500\")) {\n          dispatch({\n            type: USER_ERROR,\n            payload: \"Server error\",\n          });\n        }\n      }\n    },\n    login: async (email, password) => {\n      try {\n        const res = await axios.post(`${serverURL}/user/login`, {\n          email,\n          password,\n        });\n        const data = res.data;\n        if (res && (res.status === 200 || res.status === 201)) {\n          await actions.fetchUser();\n          history.push(\"/home\");\n        }\n        dispatch({ type: UPDATE_USER, payload: data });\n        return res;\n      } catch (err) {\n        let errorMsg;\n        if (err.message.includes(\"400\")) errorMsg = \"Invalid Credentials\";\n        if (err.message.includes(\"404\")) errorMsg = \"User not found\";\n        if (err.message.includes(\"500\")) errorMsg = \"Server error\";\n\n        dispatch({\n          type: USER_ERROR,\n          payload: errorMsg,\n        });\n      }\n    },\n    fetchUser: async () => {\n      try {\n        const res = await axios.get(`${serverURL}/user/get_current_user`);\n        if (res.status === 200) {\n          const data = await res.data;\n          dispatch({ type: UPDATE_USER, payload: data });\n          history.push(\"/home\");\n        } else {\n          history.push(\"/\");\n        }\n      } catch (err) {\n        history.push(\"/\");\n      }\n    },\n    logout: async () => {\n      try {\n        await axios.get(`${serverURL}/user/logout`);\n        history.push(\"/\");\n        dispatch({ type: USER_LOGOUT });\n      } catch (err) {\n        console.log(err.message);\n        dispatch({\n          type: USER_ERROR,\n          payload: \"Logout Error\",\n        });\n      }\n    },\n  };\n\n  useEffect(() => {\n    actions.fetchUser();\n  }, []);\n\n  useEffect(() => {\n    let timer;\n    if (userState.errorMsg) {\n      timer = setTimeout(() => {\n        actions.clearErrors();\n      }, 3000);\n    }\n    return () => clearTimeout(timer);\n  });\n\n  return (\n    <UserContext.Provider\n      value={{\n        userState,\n        userActions: actions,\n      }}\n    >\n      {props.children}\n    </UserContext.Provider>\n  );\n};\n\nexport { UserProvider, UserContext };\n","/home/evanyang/Desktop/researchcollabs/client/src/reducers/userReducer.js",[],"/home/evanyang/Desktop/researchcollabs/client/src/pages/Home/Home.js",["47"],{"ruleId":"48","replacedBy":"49"},{"ruleId":"50","replacedBy":"51"},{"ruleId":"52","severity":1,"message":"53","line":1,"column":27,"nodeType":"54","messageId":"55","endLine":1,"endColumn":36},{"ruleId":"52","severity":1,"message":"56","line":11,"column":10,"nodeType":"54","messageId":"55","endLine":11,"endColumn":20},{"ruleId":"52","severity":1,"message":"57","line":12,"column":10,"nodeType":"54","messageId":"55","endLine":12,"endColumn":23},{"ruleId":"52","severity":1,"message":"58","line":14,"column":24,"nodeType":"54","messageId":"55","endLine":14,"endColumn":33},{"ruleId":"52","severity":1,"message":"56","line":12,"column":10,"nodeType":"54","messageId":"55","endLine":12,"endColumn":20},{"ruleId":"52","severity":1,"message":"57","line":13,"column":10,"nodeType":"54","messageId":"55","endLine":13,"endColumn":23},{"ruleId":"52","severity":1,"message":"59","line":14,"column":10,"nodeType":"54","messageId":"55","endLine":14,"endColumn":30},{"ruleId":"52","severity":1,"message":"58","line":18,"column":11,"nodeType":"54","messageId":"55","endLine":18,"endColumn":20},{"ruleId":"60","severity":1,"message":"61","line":103,"column":6,"nodeType":"62","endLine":103,"endColumn":8,"suggestions":"63"},{"ruleId":"52","severity":1,"message":"58","line":6,"column":11,"nodeType":"54","messageId":"55","endLine":6,"endColumn":20},"no-native-reassign",["64"],"no-negated-in-lhs",["65"],"no-unused-vars","'useEffect' is defined but never used.","Identifier","unusedVar","'errorEmail' is assigned a value but never used.","'errorPassword' is assigned a value but never used.","'userState' is assigned a value but never used.","'errorConfirmPassword' is assigned a value but never used.","react-hooks/exhaustive-deps","React Hook useEffect has a missing dependency: 'actions'. Either include it or remove the dependency array.","ArrayExpression",["66"],"no-global-assign","no-unsafe-negation",{"desc":"67","fix":"68"},"Update the dependencies array to be: [actions]",{"range":"69","text":"70"},[2854,2856],"[actions]"]